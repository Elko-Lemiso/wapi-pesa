# Public-showcase defaults. Sensitive and external operations fail closed.
STATEMENT_PROCESSING_ENABLED=false
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
BENCHMARK_CONTRIBUTION_ENABLED=false
EMAIL_DELIVERY_ENABLED=false

# Application URL used in server-generated links and optional integrations.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Safaricom Daraja (only read when PAYMENTS_ENABLED=true).
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=

# Stripe (only read when PAYMENTS_ENABLED=true).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional integrations. Their routes remain disabled by the flags above.
DATABASE_URL=
RESEND_API_KEY=

# The current report-generation route does not call OpenRouter.
OPENROUTER_API_KEY=
